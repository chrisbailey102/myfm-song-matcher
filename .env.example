# Spotify — https://developer.spotify.com/dashboard
# Client Credentials flow (no user login) is enough for search + audio-features.
# You can put these in this file OR in spotify-key.env in the same folder.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius — https://genius.com/api-clients (for lyric search + fetch)
GENIUS_ACCESS_TOKEN=

# GetSongBPM — required for BPM/key if Spotify returns 403 on audio-features (new apps since Nov 2024)
# Free key: https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# Optional: cap pair output size (default 500000)
# MYFM_MAX_PAIRS=200000

# Optional: HTTP port for local review UI (default 3847)
# MYFM_UI_PORT=3847
