# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth redirect (must match Spotify app Settings → Redirect URIs)
# Production (custom domain on Railway):
# APP_BASE_URL=https://song-matcher.onthesly.com
# SPOTIFY_REDIRECT_URI=https://song-matcher.onthesly.com/auth/spotify/callback
# Local:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3847/auth/spotify/callback
APP_BASE_URL=http://127.0.0.1:3847

# Random 32+ char string for Spotify login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Shared On The Sly team SSO (Clerk on dashboard → ots_session cookie).
# Must match SESSION_JWT_SECRET on dashboard.onthesly.com / other tools.
# When set, unauthenticated browsers are sent to the dashboard to sign in.
# SESSION_JWT_SECRET=
# COOKIE_SECRET=   # optional; for any signed cookies; defaults to SESSION_JWT_SECRET then SESSION_SECRET

# Postgres — local: docker compose up -d db
DATABASE_URL=postgresql://myfm:myfm@localhost:5432/myfm

# GetSongBPM — https://getsongbpm.com/api (optional; ReccoBeats is preferred when Spotify audio-features 403s)
GETSONGBPM_API_KEY=

# FreqBlog — https://freqblog.com/ (BPM/key/energy when ReccoBeats misses)
FREQBLOG_API_KEY=

# Brizm — https://developers.brizm.dev/ (optional; keys look like tl_live_…)
BRIZM_API_KEY=

# Genius — Client Access Token (optional fallback; LRCLIB timed lyrics used first, no key)
GENIUS_ACCESS_TOKEN=

# Server
HOST=0.0.0.0
MYFM_UI_PORT=3847

# Optional tuning
# MYFM_BPM_TOLERANCE=10
# MYFM_MAX_PAIRS=500000
