{
  "name": "myfm-song-matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enrich a song catalog (Spotify key/BPM), find harmonic pair candidates, and score lyric bridges for short mashups.",
  "bin": {
    "myfm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "myfm": "node --import tsx src/cli.ts",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "start:ui": "node --import tsx src/server.ts",
    "start:ui:dist": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.1",
    "genius-lyrics": "^4.4.7",
    "multer": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
